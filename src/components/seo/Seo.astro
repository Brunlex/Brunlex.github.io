---
import { site } from '../../config/site';

export interface SeoProps {
  title: string;
  description: string;
  /** Ruta canónica; por defecto, la URL actual. */
  path?: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path = Astro.url.pathname, type = 'website', image = site.ogImage, publishedAt, updatedAt, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(path, Astro.site ?? site.url).toString();
const imageUrl = new URL(image, Astro.site ?? site.url).toString();
const fullTitle = title === site.name ? site.title : `${title} · ${site.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={site.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name}: ${description}`} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd.map((schema: Record<string, unknown>) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
