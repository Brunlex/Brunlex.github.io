---
import { navigation } from '../../config/site';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Bruno Eduardo, inicio">
    <span class="wordmark-mark">B<span>.</span></span>
    <span class="wordmark-name">Bruno<br />Choque</span>
  </a>
  <nav class="site-nav" aria-label="Navegación principal">
    {navigation.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="header-tools">
    <ThemeToggle />
  </div>
</header>
