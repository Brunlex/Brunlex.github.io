---
import type { PublishedEntry } from '../application/entries';
import { entryUrl } from '../application/entries';
import { categories } from '../domain/site';
interface Props { entry: PublishedEntry }
const { entry } = Astro.props;
const date = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', year: 'numeric' }).format(entry.data.publishedAt);
---

<article class="entry-card">
  <div class="entry-card-meta"><span>{categories[entry.data.category]}</span><time datetime={entry.data.publishedAt.toISOString()}>{date}</time></div>
  <h3><a href={entryUrl(entry)}>{entry.data.title}</a></h3>
  <p>{entry.data.description}</p>
  <a class="text-link" href={entryUrl(entry)} aria-label={`Leer ${entry.data.title}`}>Leer entrada <span aria-hidden="true">↗</span></a>
</article>
