---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/notebook/EntryCard.astro';
import BookCard from '../components/library/BookCard.astro';
import { highlightedEntries } from '../application/entries';
import { currentlyReading } from '../application/books';
import { personSchema, websiteSchema } from '../application/seo';
import { loadBooks, loadEntries } from '../infrastructure/content-repository';
import { site } from '../config/site';
import { profile } from '../data/profile';
import { now } from '../data/now';

const entries = highlightedEntries(await loadEntries(), 2);
const reading = currentlyReading(await loadBooks()).slice(0, 2);
---

<BaseLayout title={site.name} description={site.description} type="profile" path="/" jsonLd={[personSchema(), websiteSchema()]}>
  <section class="hero section-wrap" aria-labelledby="hero-title">
    <div class="hero-topline anim-rise">
      <span class="eyebrow">Economía · Personas · Historias</span>
      <span class="hero-location">Desde Arequipa, Perú <span class="asterisk" aria-hidden="true">✳</span></span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker anim-rise" style="--rise-delay: 60ms">Hola, soy Bruno.</p>
        <h1 id="hero-title" class="anim-rise" style="--rise-delay: 120ms">Entre los <em>datos</em><br />y las <em>historias.</em></h1>
        <p class="hero-lead anim-rise" style="--rise-delay: 200ms">{profile.introduction} Leo para entender mejor el mundo que compartimos, y aquí guardo lo que me dejan los libros.</p>
        <div class="hero-actions anim-rise" style="--rise-delay: 280ms">
          <a class="button-primary" href="/cuaderno/">Abre el cuaderno <span aria-hidden="true">↗</span></a>
          <a class="button-text" href="/trayectoria/">Conoce mi trayectoria <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-art anim-fade" aria-hidden="true">
        <div class="art-circle art-circle-one"></div>
        <div class="art-circle art-circle-two"></div>
        <div class="art-book">
          <span class="art-page"></span><span class="art-page"></span><span class="art-page"></span>
        </div>
        <span class="art-letter">B</span>
        <span class="art-caption">Una historia<br />en construcción</span>
        <span class="art-star">✳</span>
      </div>
    </div>
    <div class="hero-bottom">
      <span>01 / Una presentación</span>
      <a href="#intro-title">Desliza para conocerme <span class="scroll-cue" aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="intro-band" aria-labelledby="intro-title">
    <div class="section-wrap intro-grid">
      <div data-reveal>
        <span class="eyebrow">Una breve introducción</span>
        <h2 id="intro-title">Mirar de cerca.<br /><em>Entender mejor.</em></h2>
      </div>
      <div data-reveal>
        <p>{profile.summary}</p>
        <a class="text-link" href="/trayectoria/">Más sobre mi trabajo <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section-wrap paths-section" aria-labelledby="paths-title">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Tres formas de conocerme</span>
      <h2 id="paths-title">Lo que escribo, lo que leo<br />y lo que <em>hago.</em></h2>
    </div>
    <div class="paths-grid" data-reveal-stagger>
      <a class="path-card path-notes" href="/cuaderno/">
        <span class="path-number">01 / Cuaderno</span>
        <div><h3>Una vida entre<br /><em>páginas.</em></h3><p>Lecturas, recuerdos, ideas y momentos importantes, escritos con calma.</p></div>
        <span class="path-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="path-card path-library" href="/biblioteca/">
        <span class="path-number">02 / Biblioteca</span>
        <div><h3>Mi <em>estantería.</em></h3><p>Los libros que leo, los que me marcaron y los que esperan turno.</p></div>
        <span class="path-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="path-card path-work" href="/trayectoria/">
        <span class="path-number">03 / Trayectoria</span>
        <div><h3>Trabajo con<br /><em>propósito.</em></h3><p>Economía, datos, control patrimonial y trabajo con jóvenes.</p></div>
        <span class="path-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="quote-section" aria-labelledby="quote-title">
    <div class="section-wrap quote-inner" data-reveal>
      <span class="quote-mark" aria-hidden="true">“</span>
      <div>
        <span class="eyebrow">Una convicción</span>
        <h2 id="quote-title">Los números cuentan algo.<br /><em>Las personas les dan sentido.</em></h2>
      </div>
      <span class="quote-flower" aria-hidden="true">✳</span>
    </div>
  </section>

  {entries.length > 0 && (
    <section class="section-wrap latest-section" aria-labelledby="latest-title">
      <div class="section-heading heading-inline" data-reveal>
        <div><span class="eyebrow">Desde el cuaderno</span><h2 id="latest-title">Notas <em>recientes.</em></h2></div>
        <a class="text-link" href="/cuaderno/">Ver todas <span aria-hidden="true">↗</span></a>
      </div>
      <div class="entry-grid" data-reveal-stagger>{entries.map((entry) => <EntryCard entry={entry} />)}</div>
    </section>
  )}

  {reading.length > 0 && (
    <section class="section-wrap latest-section" aria-labelledby="reading-title">
      <div class="section-heading heading-inline" data-reveal>
        <div><span class="eyebrow">En la mesita de noche</span><h2 id="reading-title">Leyendo <em>ahora.</em></h2></div>
        <a class="text-link" href="/biblioteca/">Toda la biblioteca <span aria-hidden="true">↗</span></a>
      </div>
      <div class="book-grid" data-reveal-stagger>{reading.map((book) => <BookCard book={book} />)}</div>
    </section>
  )}

  <section class="section-wrap now-teaser" aria-labelledby="now-teaser-title">
    <div class="now-teaser-inner" data-reveal>
      <span class="eyebrow">Ahora mismo</span>
      <h2 id="now-teaser-title">{now.items[0].text}</h2>
      <a class="text-link" href="/ahora/">Qué más ocupa mis días <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
