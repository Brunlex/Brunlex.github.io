---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/notebook/EntryCard.astro';
import { adjacentEntries, categoryUrl, entryReadingMinutes, entryUrl, relatedEntries } from '../../application/entries';
import { articleSchema, breadcrumbSchema } from '../../application/seo';
import { countWords } from '../../domain/reading-time';
import { categoryLabel } from '../../domain/category';
import { loadEntries } from '../../infrastructure/content-repository';
import { formatDate } from '../../lib/format';

export const getStaticPaths = (async () => {
  const entries = await loadEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}) satisfies GetStaticPaths;

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const { title, description, publishedAt, updatedAt, category } = entry.data;
const book = entry.data.book ? await getEntry(entry.data.book) : undefined;
const path = entryUrl(entry);
const section = categoryLabel(category);
const { newer, older } = adjacentEntries(entries, entry);
const related = relatedEntries(entries, entry);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  jsonLd={[
    articleSchema({ title, description, path, publishedAt, updatedAt, section, wordCount: countWords(entry.body ?? '') }),
    breadcrumbSchema([
      { name: 'Inicio', path: '/' },
      { name: 'Cuaderno', path: '/cuaderno/' },
      { name: section, path: categoryUrl(category) },
      { name: title, path },
    ]),
  ]}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="article-page section-wrap">
    <header class="article-header">
      <nav class="breadcrumbs anim-rise" aria-label="Migas de pan">
        <a href="/cuaderno/">Cuaderno</a><span aria-hidden="true">/</span><a href={categoryUrl(category)}>{section}</a>
      </nav>
      <h1 class="anim-rise" style="--rise-delay: 80ms">{title}</h1>
      <p class="article-lead anim-rise" style="--rise-delay: 160ms">{description}</p>
      <div class="article-meta anim-rise" style="--rise-delay: 220ms">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        <span>{entryReadingMinutes(entry)} min de lectura</span>
        {updatedAt && <span>Revisado el <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></span>}
      </div>
      {book && (
        <a class="article-book anim-rise" style="--rise-delay: 280ms" href="/biblioteca/">
          <span class="eyebrow">Sobre el libro</span>
          <span><em>{book.data.title}</em> · {book.data.author}</span>
        </a>
      )}
    </header>

    <div class="prose"><Content /></div>

    <footer class="article-end">
      <span class="article-end-mark" aria-hidden="true">✳</span>
      {(newer || older) && (
        <nav class="entry-pager" aria-label="Más entradas">
          {older ? <a href={entryUrl(older)} rel="prev"><span>← Anterior</span>{older.data.title}</a> : <span></span>}
          {newer && <a href={entryUrl(newer)} rel="next"><span>Siguiente →</span>{newer.data.title}</a>}
        </nav>
      )}
    </footer>
  </article>

  {related.length > 0 && (
    <section class="section-wrap related-section" aria-labelledby="related-title">
      <div class="section-heading" data-reveal><span class="eyebrow">Sigue leyendo</span><h2 id="related-title">Páginas <em>afines.</em></h2></div>
      <div class="entry-grid" data-reveal-stagger>{related.map((item) => <EntryCard entry={item} />)}</div>
    </section>
  )}
</BaseLayout>
