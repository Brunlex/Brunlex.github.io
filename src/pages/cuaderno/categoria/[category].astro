---
import type { GetStaticPaths } from 'astro';
import NotebookArchive from '../../../components/notebook/NotebookArchive.astro';
import { categoriesInUse } from '../../../application/entries';
import { loadEntries } from '../../../infrastructure/content-repository';

export const getStaticPaths = (async () => {
  const entries = await loadEntries();
  return categoriesInUse(entries).map((category) => ({ params: { category }, props: { category, entries } }));
}) satisfies GetStaticPaths;

const { category, entries } = Astro.props;
---

<NotebookArchive entries={entries} selectedCategory={category} />
