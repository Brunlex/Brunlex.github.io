---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}
const { title, description, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).toString();
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/trayectoria/', label: 'Trayectoria' },
  { href: '/cuaderno/', label: 'Cuaderno' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2eee7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {profile.shortName}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Ir al contenido</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Bruno Eduardo, inicio"><span class="wordmark-mark">B<span>.</span></span><span class="wordmark-name">Bruno<br />Choque</span></a>
        <nav aria-label="Navegación principal">
          {nav.map((item) => <a href={item.href} aria-current={currentPath === item.href || (item.href === '/cuaderno/' && currentPath.startsWith('/cuaderno/')) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-contact" href={`mailto:${profile.email}`}>Escríbeme <span aria-hidden="true">↗</span></a>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div class="footer-top">
          <div><p class="eyebrow">Continuemos la conversación</p><h2>Las buenas ideas<br /><em>empiezan hablando.</em></h2></div>
          <a class="footer-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {profile.shortName} · Arequipa, Perú</span>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </footer>
    </div>
  </body>
</html>
