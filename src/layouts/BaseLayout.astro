---
import '../styles/global.css';
import Seo, { type SeoProps } from '../components/seo/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../config/site';

type Props = SeoProps;
const seo = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={site.themeColor.light} />
    <script is:inline>
      // Antes de pintar: marca que hay JS (para las animaciones) y aplica el tema guardado o el del sistema.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        root.dataset.theme = theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <Seo {...seo} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Cuaderno de ${site.name}`} href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Ir al contenido</a>
    <div class="site-shell">
      <Header />
      <main id="main"><slot /></main>
      <Footer />
    </div>
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
